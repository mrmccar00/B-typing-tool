# Postgres connection string (Vercel Postgres, Neon, Supabase, Azure Database for
# PostgreSQL, etc. all work). Include ?sslmode=require if your provider needs it.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Password required to log in to the results/export page.
# Choose a strong, unique value - do not reuse another system's password.
ADMIN_PASSWORD="change-me"

# Secret URL path for the results/export page. It's not linked anywhere in
# the app - visiting any other path returns a normal 404. Pick a long,
# random, hard-to-guess value (e.g. a UUID) and share it only with people
# who need to pull results. The results page 404s if this isn't set.
# Example: https://your-app.com/9f3a1c7e-results
ADMIN_PATH_SLUG="change-me-to-something-random-and-unguessable"
